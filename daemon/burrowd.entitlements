<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Entitlements of burrowd and burrowctl. Both read the crash reports in
     /var/mobile/Library/Logs/CrashReporter. On iOS 18.1.1 with RootHide
     Dopamine, a program without these two runs in a sandbox that keeps it
     from the reports, root's included; with them it reads them without
     any storage entitlement. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
</dict>
</plist>
